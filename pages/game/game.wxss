/* pages/game/game.wxss */
.game {
  position: relative;
  width: 100%;
  height: 100vh;
  background: linear-gradient(180deg, #fff3e0 0%, #ffe0b2 100%);
}

.canvas {
  width: 100%;
  height: 100%;
  display: block;
}

/* HUD */
.hud {
  position: absolute;
  top: 24rpx;
  left: 0;
  right: 0;
  display: flex;
  flex-direction: column;
  align-items: center;
  pointer-events: none;
}

.target {
  font-size: 40rpx;
  color: #5a2d00;
  font-weight: 600;
}

.target-letter {
  display: inline-block;
  margin-left: 12rpx;
  font-size: 88rpx;
  font-weight: 900;
  color: #ff7a18;
  text-shadow: 0 3rpx 0 #fff;
  background: rgba(255, 255, 255, 0.55);
  border-radius: 20rpx;
  padding: 0 26rpx;
  line-height: 1.2;
}

.hud-row {
  margin-top: 16rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.hud-score {
  font-size: 52rpx;
  font-weight: 800;
  color: #ff7a18;
  text-shadow: 0 2rpx 0 #fff;
  transform: scale(1);
  margin-right: 28rpx;
}

.hud-score.bump {
  animation: bump 0.25s ease;
}

@keyframes bump {
  0% { transform: scale(1); }
  50% { transform: scale(1.35); }
  100% { transform: scale(1); }
}

.hud-lives, .hud-level {
  font-size: 30rpx;
  color: #8a5a2b;
  margin-left: 20rpx;
}

.hud-group {
  margin-top: 8rpx;
  font-size: 26rpx;
  color: #b06a2b;
}

/* 结束卡片 */
.overlay {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.35);
  display: flex;
  align-items: center;
  justify-content: center;
}

.card {
  width: 560rpx;
  background: #fff;
  border-radius: 32rpx;
  padding: 56rpx 40rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  box-shadow: 0 20rpx 60rpx rgba(0, 0, 0, 0.25);
  animation: pop 0.35s cubic-bezier(0.34, 1.56, 0.64, 1);
}

@keyframes pop {
  0% { transform: scale(0.6); opacity: 0; }
  100% { transform: scale(1); opacity: 1; }
}

.card-title {
  font-size: 48rpx;
  font-weight: 800;
  color: #5a2d00;
}

.card-score {
  margin-top: 28rpx;
  font-size: 40rpx;
  color: #ff7a18;
  font-weight: 700;
}

.card-best {
  margin-top: 12rpx;
  font-size: 30rpx;
  color: #8a5a2b;
}

.card .btn-primary {
  margin-top: 48rpx;
  width: 320rpx;
}
