/* pages/index/index.wxss */
.home {
  position: relative;
  width: 100%;
  height: 100vh;
  overflow: hidden;
}

.home-bg {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: linear-gradient(180deg, #ffe9c7 0%, #ffcf8f 55%, #ff9d4d 100%);
}

.home-content {
  position: relative;
  z-index: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  height: 100%;
  padding: 0 60rpx;
}

.title {
  font-size: 88rpx;
  font-weight: 800;
  color: #5a2d00;
  letter-spacing: 8rpx;
}

.subtitle {
  margin-top: 24rpx;
  font-size: 30rpx;
  color: #8a5a2b;
}

.start-btn {
  margin-top: 80rpx;
  width: 360rpx;
}

.best {
  margin-top: 48rpx;
  font-size: 30rpx;
  color: #8a5a2b;
}
