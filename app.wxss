/* app.wxss —— 全局样式（渐变背景 + 主按钮，可复用） */
page {
  background: linear-gradient(180deg, #fff3e0 0%, #ffe0b2 100%);
  height: 100%;
}

.btn-primary {
  background: linear-gradient(180deg, #ff9d4d 0%, #ff7a18 100%);
  color: #fff;
  border-radius: 999rpx;
  font-size: 36rpx;
  font-weight: 600;
  padding: 20rpx 0;
  border: none;
  box-shadow: 0 8rpx 20rpx rgba(255, 122, 24, 0.35);
}

.btn-primary::after {
  border: none;
}
